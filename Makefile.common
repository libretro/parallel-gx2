	$(LRC_DIR)/crypto/x509.c \
	$(LRC_DIR)/encodings/encoding_base64.c \
	$(LRC_DIR)/encodings/encoding_crc32.c \
	$(LRC_DIR)/encodings/encoding_deflate.c \
	$(LRC_DIR)/encodings/encoding_rzstd.c \
	$(LRC_DIR)/encodings/encoding_utf.c \
	$(LRC_DIR)/encodings/encoding_xxh64.c \
	$(LRC_DIR)/features/features_cpu.c \
	$(LRC_DIR)/file/file_path.c \
	$(LRC_DIR)/file/file_path_io.c \
	$(LRC_DIR)/file/retro_dirent.c \
	$(LRC_DIR)/formats/h264/rh264.c \
	$(LRC_DIR)/formats/zar/zar.c \
	$(LRC_DIR)/formats/zar/zar_write.c \
	$(LRC_DIR)/formats/xml/rxml.c \
	$(LRC_DIR)/gfx/shaders/rslc_dxbc.c \
	$(LRC_DIR)/gfx/shaders/rslc_front.c \
	$(LRC_DIR)/gfx/shaders/rslc_ir.c \
	$(LRC_DIR)/hash/lrc_hash.c \
	$(LRC_DIR)/lists/string_list.c \
	$(LRC_DIR)/net/net_compat.c \
	$(LRC_DIR)/net/net_http.c \
	$(LRC_DIR)/net/net_socket.c \
	$(LRC_DIR)/net/net_socket_ssl_retro.c \
	$(LRC_DIR)/queues/retro_spsc.c \
	$(LRC_DIR)/rthreads/retro_eventcount.c \
	$(LRC_DIR)/rthreads/rthreads.c \
	$(LRC_DIR)/rthreads/tpool.c \
	$(LRC_DIR)/streams/file_stream.c \
	$(LRC_DIR)/string/rstrtod.c \
	$(LRC_DIR)/string/stdstring.c \
	$(LRC_DIR)/time/rtime.c \
	$(LRC_DIR)/utils/md5.c \
	$(LRC_DIR)/vfs/vfs_hybrid.c \
	$(LRC_DIR)/vfs/vfs_implementation.c
# rslc: the shader compiler, SPIR-V alone (RSLC_NO_TEXT), with the samplers
# and stages the console's shaders use (RSLC_EXTENDED)
LRC_FLAGS := -I$(LRC_DIR)/include -DHAVE_SSL -DHAVE_RETROSSL -DHAVE_CRYPTO -DHAVE_THREADS -DHAVE_RZSTD \
	-DRSLC_EXTENDED -DRSLC_NO_TEXT
# libco: Android's fibers (FiberAndroid.cpp), and the OpenGL GPU, which runs as
# a cothread of the frontend's thread because the frontend's context is current
# there and nowhere else (LatteThread.cpp). Per-thread state (LIBCO_MP): more
# than one thread switches cothreads. Windows gets its own fibers, as libco.c
# only picks those for MSVC.
ifneq (,$(filter 1,$(OS_ANDROID) $(HAVE_OPENGL)))
   LRC_FLAGS += -DLIBCO_MP
   ifeq ($(OS_WIN),1)
      LRC_SOURCES_C += $(LRC_DIR)/libco/fiber.c
   else
      LRC_SOURCES_C += $(LRC_DIR)/libco/libco.c
   endif
endif

# ----------------------------------------------------------------------------
# Dependencies
# ----------------------------------------------------------------------------
# fmt is header-only except on Android (precompiled.h): format.cc there only,
# as its definitions and the inline ones every other TU has would clash where
# the linker does not merge them (PE/COFF)
FMT_SOURCES_CXX := $(DEP_DIR)/fmt/src/os.cc
FMT_FLAGS := -I$(DEP_DIR)/fmt/include -w
ifeq ($(OS_ANDROID),1)
   FMT_SOURCES_CXX += $(DEP_DIR)/fmt/src/format.cc
else
   FMT_FLAGS += -DFMT_HEADER_ONLY
endif

LIBUSB_DIR := $(DEP_DIR)/libusb/libusb
LIBUSB_SOURCES_C := $(addprefix $(LIBUSB_DIR)/,core.c descriptor.c hotplug.c io.c strerror.c sync.c)
ifneq (,$(filter 1,$(OS_LINUX) $(OS_ANDROID)))
   LIBUSB_SOURCES_C += $(LIBUSB_DIR)/os/linux_usbfs.c $(LIBUSB_DIR)/os/linux_netlink.c
endif
ifeq ($(OS_UNIX),1)
   LIBUSB_SOURCES_C += $(LIBUSB_DIR)/os/events_posix.c $(LIBUSB_DIR)/os/threads_posix.c
endif
ifeq ($(OS_WIN),1)
   LIBUSB_SOURCES_C += $(addprefix $(LIBUSB_DIR)/os/,threads_windows.c windows_common.c \
	windows_usbdk.c windows_winusb.c events_windows.c)
endif
ifeq ($(OS_MACOS),1)
   LIBUSB_SOURCES_C += $(LIBUSB_DIR)/os/darwin_usb.c
endif
LIBUSB_FLAGS := -I$(DEP_DIR)/libusb-config -I$(LIBUSB_DIR) -w

XBYAK_SOURCES_CXX := $(DEP_DIR)/xbyak_aarch64/src/xbyak_aarch64_impl.cpp $(DEP_DIR)/xbyak_aarch64/src/util_impl.cpp
XBYAK_FLAGS := -I$(DEP_DIR)/xbyak_aarch64 -I$(DEP_DIR)/xbyak_aarch64/xbyak_aarch64 -w

LIB_GROUPS := CORE LRC FMT
ifeq ($(HAVE_LIBUSB),1)
   LIB_GROUPS += LIBUSB
endif
ifeq ($(ARCH_ARM64),1)
   LIB_GROUPS += XBYAK
endif
