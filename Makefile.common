# Each recompiler backend only for its own architecture: the core links all
# its objects into one library, not a static one as standalone does, so the
# x64 backend in an arm64 core clashes with the AArch64 one
# (PPCRecompiler_virtualHLE).
ifeq ($(ARCH_X86_64),1)
   CORE_SOURCES_CXX += \
	$(CORE_DIR)/src/Cafe/HW/Espresso/Recompiler/BackendX64/BackendX64.cpp \
	$(CORE_DIR)/src/Cafe/HW/Espresso/Recompiler/BackendX64/BackendX64AVX.cpp \
	$(CORE_DIR)/src/Cafe/HW/Espresso/Recompiler/BackendX64/BackendX64BMI.cpp \
	$(CORE_DIR)/src/Cafe/HW/Espresso/Recompiler/BackendX64/BackendX64FPU.cpp \
	$(CORE_DIR)/src/Cafe/HW/Espresso/Recompiler/BackendX64/BackendX64Gen.cpp \
	$(CORE_DIR)/src/Cafe/HW/Espresso/Recompiler/BackendX64/BackendX64GenFPU.cpp
endif
ifeq ($(ARCH_ARM64),1)
   CORE_SOURCES_CXX += \
	$(SRC_DIR)/Cafe/HW/Espresso/Recompiler/BackendAArch64/BackendAArch64.cpp
endif

CORE_FLAGS := -DENABLE_LIBRETRO -DRETRO_CORE -DVK_NO_PROTOTYPES \
	-DEMULATOR_VERSION_MAJOR=0 -DEMULATOR_VERSION_MINOR=0 -DEMULATOR_VERSION_PATCH=0 \
	-DEMULATOR_HASH=$(GIT_HASH) \
	-I$(SRC_DIR) -I$(SRC_DIR)/Cafe -I$(SRC_DIR)/Common -I$(SRC_DIR)/util -I$(SRC_DIR)/Cemu \
	-I$(SRC_DIR)/input -I$(SRC_DIR)/config -I$(SRC_DIR)/audio \
	-I$(SRC_DIR)/gui -I$(SRC_DIR)/gui/interface -I$(SRC_DIR)/libretro -I$(SRC_DIR)/resource \
	-I$(DEP_DIR)/Vulkan-Headers/include \
	-I$(DEP_DIR)/glm -I$(DEP_DIR)/fmt/include \
	-I$(DEP_DIR)/boost-compat \
	-I$(DEP_DIR)/libusb-config \
	-I$(LRC_DIR)/include
CORE_WARNFLAGS := -Wno-multichar -Wno-invalid-offsetof -Wno-switch -Wno-ignored-attributes \
	-Wno-deprecated-enum-enum-conversion
ifeq ($(HAVE_VULKAN),1)
   CORE_FLAGS += -DENABLE_VULKAN
endif
ifeq ($(HAVE_OPENGL),1)
   CORE_FLAGS += -DENABLE_OPENGL
endif
ifeq ($(HAVE_METAL),1)
   CORE_FLAGS += -DENABLE_METAL -I$(DEP_DIR)/metal-cpp
endif
# No VK_USE_PLATFORM_*: the surface and the swapchain are the frontend's, so
# no window-system header is ever included
ifeq ($(HAVE_LIBUSB),1)
   CORE_FLAGS += -DHAS_LIBUSB
endif
ifeq ($(ARCH_ARM64),1)
   CORE_FLAGS += -I$(DEP_DIR)/xbyak_aarch64 -I$(DEP_DIR)/xbyak_aarch64/xbyak_aarch64
endif

# Every unit of the core starts with Common/precompiled.h, read
# precompiled: a stub of that name is force-included, and the compiler
# takes the precompiled header next to it in its place (GCC a .gch, which
# it skips for the stub when the flags do not match; Clang a .pch).
# No absolute paths here: on MSYS2, make's are /c/... ones, which a native
# MinGW compiler cannot open (MSYS converts them on a command line, never
# inside the stub). The stub finds the header through -I$(SRC_DIR).
CORE_PCH_HEADER := $(SRC_DIR)/Common/precompiled.h
CORE_PCH_INCLUDE := $(CORE_PCH_HEADER)
ifneq ($(NO_PCH),1)
   CORE_PCH_STUB := $(OBJ_DIR)/pch/precompiled.h
   ifneq (,$(findstring clang,$(shell $(CXX) --version 2>/dev/null)))
      CORE_PCH := $(CORE_PCH_STUB).pch
   else
      CORE_PCH := $(CORE_PCH_STUB).gch
   endif
   # rewritten only when the flags change, which is when the PCH must be
   CORE_PCH_FLAGS = $(CXXFLAGS) $(CORE_FLAGS) $(CORE_WARNFLAGS)
   # the stub is written (Makefile, with the flags) only when its line
   # changed, so a tree built with an older one picks the new one up
   CORE_PCH_STUB_LINE := \#include "Common/precompiled.h"
   $(CORE_PCH): $(CORE_PCH_STUB) $(OBJ_DIR)/pch/flags $(SRC_DIR)/Common/precompiled.h
	@$(if $(E),echo PCH $<,)
	$(CXX) $(CORE_PCH_FLAGS) -MMD -MP -MF $(CORE_PCH_STUB).d -MT $@ -x c++-header -c $< -o $@
   CORE_PCH_INCLUDE := $(CORE_PCH_STUB)
endif
CORE_CXXFLAGS := -include $(CORE_PCH_INCLUDE) $(CORE_WARNFLAGS)

# ----------------------------------------------------------------------------
# The part of libretro-common the core uses
# ----------------------------------------------------------------------------
LRC_SOURCES_C := \
	$(LRC_DIR)/compat/compat_posix_string.c \
	$(LRC_DIR)/compat/compat_strcasestr.c \
	$(LRC_DIR)/compat/compat_strl.c \
	$(LRC_DIR)/compat/fopen_utf8.c \
