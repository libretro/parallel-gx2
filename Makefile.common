# Source lists and per-library flags for the static Makefile build of the
# parallel_gx2 libretro core. Included by Makefile, which sets the platform
# switches used here:
#
#   ARCH_X86_64 / ARCH_ARM64                     target architecture
#   OS_WIN / OS_UNIX                             OS family
#   OS_LINUX (Linux, webOS) / OS_ANDROID / OS_APPLE, with OS_MACOS or OS_IOS
#   HAVE_LIBUSB HAVE_VULKAN HAVE_OPENGL HAVE_METAL   optional components
#
# Units only the standalone emulator uses are left out.

DEP_DIR := $(CORE_DIR)/dependencies
SRC_DIR := $(CORE_DIR)/src
LRC_DIR := $(DEP_DIR)/libretro-common

# ----------------------------------------------------------------------------
# Generated files
# ----------------------------------------------------------------------------
GRAPHIC_PACKS_C := $(GEN_DIR)/libretro_graphic_packs.cpp
PACK_TOOL       := $(GEN_DIR)/pack_graphic_packs$(HOST_EXE)

# The community graphic packs, compiled in (src/libretro/LibretroGraphicPacks.cpp)
GRAPHIC_PACKS_DIR := $(DEP_DIR)/cemu_graphic_packs
PACK_TOOL_SOURCES := $(CORE_DIR)/tools/pack_graphic_packs.c \
	$(addprefix $(LRC_DIR)/,encodings/encoding_deflate.c encodings/encoding_crc32.c \
	features/features_cpu.c compat/compat_strl.c time/rtime.c)
$(PACK_TOOL): $(PACK_TOOL_SOURCES)
	@mkdir -p $(@D)
	$(HOSTCC) -O2 -I$(LRC_DIR)/include $(PACK_TOOL_SOURCES) -o $@
# The packs' names have spaces, which make cannot take as prerequisites:
# a stamp with a checksum of the tree's listing stands in for them, and is
# rewritten only when that changes.
GRAPHIC_PACKS_STAMP := $(GEN_DIR)/graphic_packs.stamp
GRAPHIC_PACKS_STATUS := $(shell mkdir -p $(GEN_DIR); \
	(cd $(GRAPHIC_PACKS_DIR) 2>/dev/null && ls -lR Enhancements Resolutions Mods Workarounds src LICENSE.md 2>/dev/null) \
		| cksum > $(GRAPHIC_PACKS_STAMP).tmp; \
	cmp -s $(GRAPHIC_PACKS_STAMP).tmp $(GRAPHIC_PACKS_STAMP) || mv -f $(GRAPHIC_PACKS_STAMP).tmp $(GRAPHIC_PACKS_STAMP); \
	rm -f $(GRAPHIC_PACKS_STAMP).tmp)
$(GRAPHIC_PACKS_C): $(PACK_TOOL) $(GRAPHIC_PACKS_STAMP)
	@mkdir -p $(@D)
	$(PACK_TOOL) $(GRAPHIC_PACKS_DIR) $@

# The commit the core is built from, for log.txt
GIT_HASH := $(shell git -C $(CORE_DIR) log --format=%h -1 2>/dev/null)
ifeq ($(GIT_HASH),)
   GIT_HASH := unknown
endif

